# Copy to .env, fill in your own API key, and keep .env private.
OPENAI_API_KEY=

# Use the same model and API settings in every comparison condition.
# Model access depends on your account; no automatic fallback is configured.
OPENAI_REWARD_MODEL=gpt-6.1-sol
REWARD_ENGINEER_REASONING_MODE=pro
REWARD_ENGINEER_REASONING_EFFORT=max
OPENAI_MODEL_VERBOSITY=medium
REWARD_ENGINEER_MAX_TURNS=64
REWARD_ENGINEER_TIMEOUT_SECONDS=5400
REWARD_ENGINEER_SHELL_TIMEOUT_SECONDS=300
MAX_DESIGN_REPAIRS=2

# Optional full-budget development probes share each candidate's design time.
LEARNING_PROBE_JOBS=2
LEARNING_PROBE_TIMEOUT_SECONDS=3600
TRAINING_JOB_TIMEOUT_SECONDS=86400
TRAINING_JOB_RETRIES=0

# Policy-training seeds are not independent language-model reward searches.
NUM_TRAIN_SEEDS=1
# Fresh held-out policies per scenario, for native and all selected rewards.
NUM_HELD_OUT_SEEDS=10
SEARCH_REPLICATE=0

# Set scientific settings before registration and preserve them on resume.
OVERCOOKED_TIMESTEPS=5000000
SMAX_TIMESTEPS=5000000
OVERCOOKED_EVAL_EPISODES=64
SMAX_EVAL_EPISODES=256
OVERCOOKED_TRACE_EPISODES=8
SMAX_TRACE_EPISODES=16
OVERCOOKED_REWARD_WEIGHT=0.1
SMAX_REWARD_WEIGHT=0.01
EVALUATION_GREEDY=0

# Raw observational episodes at intermediate checkpoints (20%/60% targets).
TRAINING_SNAPSHOT_EPISODES=2

# Full studies require CUDA.
REQUIRE_GPU=1
